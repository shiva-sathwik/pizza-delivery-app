# Server Port
PORT=5000

# MongoDB Connection String (Local MongoDB or MongoDB Atlas URI)
MONGODB_URI=mongodb://127.0.0.1:27017/pizza-delivery-app

# Frontend Client URL for CORS & Email Links
CLIENT_URL=http://localhost:5173

# Environment
NODE_ENV=development

# JWT Configuration
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=7d

# Email Service (SMTP / Nodemailer)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your_smtp_username
SMTP_PASSWORD=your_smtp_password
EMAIL_FROM="PizzaFlow" <no-reply@pizzaflow.com>
ADMIN_ALERT_EMAIL=admin@pizzaflow.com

# Low-Stock Alert Cron Configuration
INVENTORY_ALERT_CRON_SCHEDULE="0 */6 * * *"
ENABLE_INVENTORY_ALERT_CRON=true

# Initial Admin Seeding (for npm run seed:admin)
ADMIN_NAME=Super Admin
ADMIN_EMAIL=admin@pizzaflow.com
ADMIN_PASSWORD=adminSecurePassword123

# Razorpay Payment Gateway (TEST MODE Placeholders - Never commit real keys)
RAZORPAY_KEY_ID=rzp_test_placeholder_key_id
RAZORPAY_KEY_SECRET=placeholder_secret_never_commit_real_secret
